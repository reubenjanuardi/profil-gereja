# Database Connection (PostgreSQL / Supabase)
# If using Supabase Connection Pooler (aws-*.pooler.supabase.com), username MUST be postgres.<PROJECT_REF>
DATABASE_URI=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SCHEMA=portal

# Payload CMS Secret Key
PAYLOAD_SECRET=your-payload-secret-at-least-32-characters-long

# Cloudflare R2 Storage (S3-compatible)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET=gereja-media
S3_REGION=auto

# Server / Public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
